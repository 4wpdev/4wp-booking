{
	"name": "4wp-dev/4wp-booking",
	"description": "4WP Booking — pluggable appointment booking (ClinicCards live; Google Calendar and Calendly planned).",
	"type": "wordpress-plugin",
	"version": "0.4.0",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"4wpdev/4wp-dev-toolkit": "@dev"
	},
	"repositories": [
		{
			"type": "path",
			"url": "../4wp-dev-toolkit",
			"options": {
				"symlink": true
			}
		}
	],
	"autoload": {
		"psr-4": {
			"ForWP\\Booking\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"ForWP\\Booking\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"test": "phpunit"
	}
}
