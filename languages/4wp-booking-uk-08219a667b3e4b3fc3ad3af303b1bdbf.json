{"translation-revision-date":"2026-08-27 17:20+0300","generator":"WP-CLI\/2.12.0","source":"src\/admin\/App.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"uk","plural-forms":"nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<12 || n%100>14) ? 1 : 2);"},"4WP Booking":["4WP Booking"],"By service":["\u0417\u0430 \u043f\u043e\u0441\u043b\u0443\u0433\u043e\u044e"],"By date":["\u0417\u0430 \u0434\u0430\u0442\u043e\u044e"],"By doctor":["\u0417\u0430 \u043b\u0456\u043a\u0430\u0440\u0435\u043c"],"Select a service":["\u041e\u0431\u0435\u0440\u0456\u0442\u044c \u043f\u043e\u0441\u043b\u0443\u0433\u0443"],"Select a date":["\u041e\u0431\u0435\u0440\u0456\u0442\u044c \u0434\u0430\u0442\u0443"],"Select a time":["\u041e\u0431\u0435\u0440\u0456\u0442\u044c \u0447\u0430\u0441"],"Your details":["\u0412\u0430\u0448\u0456 \u0434\u0430\u043d\u0456"],"First name":["\u0406\u043c'\u044f"],"Last name":["\u041f\u0440\u0456\u0437\u0432\u0438\u0449\u0435"],"Phone":["\u0422\u0435\u043b\u0435\u0444\u043e\u043d"],"Email":["Email"],"Comment":["\u041a\u043e\u043c\u0435\u043d\u0442\u0430\u0440"],"Confirm booking":["\u041f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0438 \u0437\u0430\u043f\u0438\u0441"],"Back":["\u041d\u0430\u0437\u0430\u0434"],"Ready":["\u0413\u043e\u0442\u043e\u0432\u043e"],"Provider":["\u041f\u0440\u043e\u0432\u0430\u0439\u0434\u0435\u0440"],"Template":["\u0428\u0430\u0431\u043b\u043e\u043d"],"Needs API key":["\u041f\u043e\u0442\u0440\u0456\u0431\u0435\u043d API-\u043a\u043b\u044e\u0447"],"Calendar":["\u041a\u0430\u043b\u0435\u043d\u0434\u0430\u0440"],"About this plugin":["\u041f\u0440\u043e \u0446\u0435\u0439 \u043f\u043b\u0430\u0433\u0456\u043d"],"4WP Booking adds a native appointment calendar to WordPress. Visitors pick a service, date, and time. API secrets stay on the server.":["4WP Booking \u0434\u043e\u0434\u0430\u0454 \u0432\u043b\u0430\u0441\u043d\u0438\u0439 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440 \u0437\u0430\u043f\u0438\u0441\u0443 \u0434\u043e WordPress. \u0412\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u0447 \u043e\u0431\u0438\u0440\u0430\u0454 \u043f\u043e\u0441\u043b\u0443\u0433\u0443, \u0434\u0430\u0442\u0443 \u0439 \u0447\u0430\u0441. API-\u0441\u0435\u043a\u0440\u0435\u0442\u0438 \u0437\u0430\u043b\u0438\u0448\u0430\u044e\u0442\u044c\u0441\u044f \u043d\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0456."],"ClinicCards is live. Google Calendar and Calendly are registered as roadmap stubs until those integrations ship.":["ClinicCards \u0443\u0436\u0435 \u043f\u0440\u0430\u0446\u044e\u0454. Google Calendar \u0456 Calendly \u0437\u0430\u0440\u0435\u0454\u0441\u0442\u0440\u043e\u0432\u0430\u043d\u0456 \u044f\u043a \u0437\u0430\u0433\u043b\u0443\u0448\u043a\u0438, \u0434\u043e\u043a\u0438 \u0456\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u0457 \u043d\u0435 \u0437'\u044f\u0432\u043b\u044f\u0442\u044c\u0441\u044f."],"Pick a provider card below to configure credentials and load a live admin preview.":["\u041e\u0431\u0435\u0440\u0456\u0442\u044c \u043a\u0430\u0440\u0442\u043a\u0443 \u043f\u0440\u043e\u0432\u0430\u0439\u0434\u0435\u0440\u0430 \u043d\u0438\u0436\u0447\u0435, \u0449\u043e\u0431 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438 \u0434\u043e\u0441\u0442\u0443\u043f \u0456 \u043f\u043e\u0431\u0430\u0447\u0438\u0442\u0438 \u0436\u0438\u0432\u0438\u0439 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u0456\u0439 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434."],"Preview request failed.":["\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u0456\u0439 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434."],"Frontend preview (schematic)":["\u041f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u0456\u0439 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434 \u0444\u0440\u043e\u043d\u0442\u0435\u043d\u0434\u0443 (\u0441\u0445\u0435\u043c\u0430)"],"Services":["\u041f\u043e\u0441\u043b\u0443\u0433\u0438"],"Status":["\u0421\u0442\u0430\u0442\u0443\u0441"],"Planned":["\u0423 \u043f\u043b\u0430\u043d\u0430\u0445"],"When this provider is implemented, live values will replace the placeholders.":["\u041a\u043e\u043b\u0438 \u043f\u0440\u043e\u0432\u0430\u0439\u0434\u0435\u0440 \u0431\u0443\u0434\u0435 \u0440\u0435\u0430\u043b\u0456\u0437\u043e\u0432\u0430\u043d\u043e, \u0436\u0438\u0432\u0456 \u0434\u0430\u043d\u0456 \u0437\u0430\u043c\u0456\u043d\u044f\u0442\u044c \u0437\u0430\u0433\u043b\u0443\u0448\u043a\u0438."],"Frontend preview (live)":["\u041f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u0456\u0439 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434 \u0444\u0440\u043e\u043d\u0442\u0435\u043d\u0434\u0443 (\u0436\u0438\u0432\u0438\u0439)"],"Connection":["\u041f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f"],"Sample":["\u041f\u0440\u0438\u043a\u043b\u0430\u0434"],"Could not load settings.":["\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f."],"Could not save settings.":["\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f."],"Settings saved.":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043e."],"\u2190 Back to overview":["\u2190 \u0414\u043e \u043e\u0433\u043b\u044f\u0434\u0443"],"API secret is stored in WordPress only; the calendar talks to REST without exposing keys.":["API-\u0441\u0435\u043a\u0440\u0435\u0442 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u043b\u0438\u0448\u0435 \u0432 WordPress; \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440 \u0437\u0432\u0435\u0440\u0442\u0430\u0454\u0442\u044c\u0441\u044f \u0434\u043e REST \u0431\u0435\u0437 \u0440\u043e\u0437\u043a\u0440\u0438\u0442\u0442\u044f \u043a\u043b\u044e\u0447\u0456\u0432."],"API key":["API-\u043a\u043b\u044e\u0447"],"A key is saved. Click the field, paste the new key, then Save. Saving empty keeps the current key.":["\u041a\u043b\u044e\u0447 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043e. \u041a\u043b\u0456\u043a\u043d\u0456\u0442\u044c \u043f\u043e\u043b\u0435, \u0432\u0441\u0442\u0430\u0432\u0442\u0435 \u043d\u043e\u0432\u0438\u0439 \u043a\u043b\u044e\u0447 \u0456 \u043d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u00ab\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438\u00bb. \u041f\u043e\u0440\u043e\u0436\u043d\u0454 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f \u043b\u0438\u0448\u0430\u0454 \u043f\u043e\u0442\u043e\u0447\u043d\u0438\u0439 \u043a\u043b\u044e\u0447."],"Stored server-side only; never exposed to the frontend.":["\u0417\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u043b\u0438\u0448\u0435 \u043d\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0456; \u043d\u0430 \u0444\u0440\u043e\u043d\u0442\u0435\u043d\u0434 \u043d\u0435 \u043f\u043e\u0442\u0440\u0430\u043f\u043b\u044f\u0454."],"Credential actions":["\u0414\u0456\u0457 \u0437 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u043c\u0438 \u0434\u0430\u043d\u0438\u043c\u0438"],"Save":["\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438"],"Reload":["\u041e\u043d\u043e\u0432\u0438\u0442\u0438"],"This provider is listed for architecture and roadmap planning only. No credentials or live requests are available yet.":["\u0426\u0435\u0439 \u043f\u0440\u043e\u0432\u0430\u0439\u0434\u0435\u0440 \u0443 \u0441\u043f\u0438\u0441\u043a\u0443 \u043b\u0438\u0448\u0435 \u0434\u043b\u044f \u0430\u0440\u0445\u0456\u0442\u0435\u043a\u0442\u0443\u0440\u0438 \u0442\u0430 \u043f\u043b\u0430\u043d\u0443. \u041e\u0431\u043b\u0456\u043a\u043e\u0432\u0456 \u0434\u0430\u043d\u0456 \u0439 \u0436\u0438\u0432\u0456 \u0437\u0430\u043f\u0438\u0442\u0438 \u0449\u0435 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0456."],"Provider registry":["\u0420\u0435\u0454\u0441\u0442\u0440 \u043f\u0440\u043e\u0432\u0430\u0439\u0434\u0435\u0440\u0456\u0432"],"Click a card to configure or preview.":["\u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u043a\u0430\u0440\u0442\u043a\u0443, \u0449\u043e\u0431 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438 \u0430\u0431\u043e \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438."],"Open details for %s":["\u0412\u0456\u0434\u043a\u0440\u0438\u0442\u0438 \u0434\u0435\u0442\u0430\u043b\u0456: %s"],"Live":["\u041f\u0440\u0430\u0446\u044e\u0454"],"List":["\u0421\u043f\u0438\u0441\u043e\u043a"],"List heading":["\u0417\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a \u0441\u043f\u0438\u0441\u043a\u0443"],"Text under the doctor list":["\u0422\u0435\u043a\u0441\u0442 \u043f\u0456\u0434 \u0441\u043f\u0438\u0441\u043a\u043e\u043c \u043b\u0456\u043a\u0430\u0440\u0456\u0432"],"Tabs & calendar":["\u0412\u043a\u043b\u0430\u0434\u043a\u0438 \u0442\u0430 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440"],"Tab: by service":["\u0412\u043a\u043b\u0430\u0434\u043a\u0430: \u0437\u0430 \u043f\u043e\u0441\u043b\u0443\u0433\u043e\u044e"],"Tab: by date":["\u0412\u043a\u043b\u0430\u0434\u043a\u0430: \u0437\u0430 \u0434\u0430\u0442\u043e\u044e"],"Tab: by doctor":["\u0412\u043a\u043b\u0430\u0434\u043a\u0430: \u0437\u0430 \u043b\u0456\u043a\u0430\u0440\u0435\u043c"],"Guest form":["\u0424\u043e\u0440\u043c\u0430 \u0433\u043e\u0441\u0442\u044f"],"Messages":["\u041f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f"],"Error: required field":["\u041f\u043e\u043c\u0438\u043b\u043a\u0430: \u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u0435 \u043f\u043e\u043b\u0435"],"Error: name":["\u041f\u043e\u043c\u0438\u043b\u043a\u0430: \u0456\u043c'\u044f"],"Error: phone":["\u041f\u043e\u043c\u0438\u043b\u043a\u0430: \u0442\u0435\u043b\u0435\u0444\u043e\u043d"],"Error: email":["\u041f\u043e\u043c\u0438\u043b\u043a\u0430: email"],"Success message":["\u041f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f \u043f\u0440\u043e \u0443\u0441\u043f\u0456\u0445"],"Done heading":["\u0417\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a \u043f\u0456\u0441\u043b\u044f \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f"],"Empty states":["\u041f\u043e\u0440\u043e\u0436\u043d\u0456 \u0441\u0442\u0430\u043d\u0438"],"Empty doctor list":["\u041f\u043e\u0440\u043e\u0436\u043d\u0456\u0439 \u0441\u043f\u0438\u0441\u043e\u043a \u043b\u0456\u043a\u0430\u0440\u0456\u0432"],"Empty service list":["\u041f\u043e\u0440\u043e\u0436\u043d\u0456\u0439 \u0441\u043f\u0438\u0441\u043e\u043a \u043f\u043e\u0441\u043b\u0443\u0433"],"No times on this day":["\u041d\u0435\u043c\u0430\u0454 \u0433\u043e\u0434\u0438\u043d \u043d\u0430 \u0446\u0435\u0439 \u0434\u0435\u043d\u044c"],"No free times this month":["\u041d\u0435\u043c\u0430\u0454 \u0432\u0456\u043b\u044c\u043d\u0438\u0445 \u0433\u043e\u0434\u0438\u043d \u0446\u044c\u043e\u0433\u043e \u043c\u0456\u0441\u044f\u0446\u044f"],"Notifications":["\u0421\u043f\u043e\u0432\u0456\u0449\u0435\u043d\u043d\u044f"],"Each booking (with date and time) is copied here.":["\u041a\u043e\u0436\u0435\u043d \u0437\u0430\u043f\u0438\u0441 (\u0437 \u0434\u0430\u0442\u043e\u044e \u0439 \u0447\u0430\u0441\u043e\u043c) \u0434\u0443\u0431\u043b\u044e\u0454\u0442\u044c\u0441\u044f \u0441\u044e\u0434\u0438."],"Recipients":["\u041e\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0447\u0456"],"Leave empty to use the WordPress admin email. Separate addresses with commas.":["\u0417\u0430\u043b\u0438\u0448\u0442\u0435 \u043f\u043e\u0440\u043e\u0436\u043d\u0456\u043c, \u0449\u043e\u0431 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0442\u0438 email \u0430\u0434\u043c\u0456\u043d\u0456\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u0430 WordPress. \u0410\u0434\u0440\u0435\u0441\u0438 \u0440\u043e\u0437\u0434\u0456\u043b\u044f\u0439\u0442\u0435 \u043a\u043e\u043c\u0430\u043c\u0438."],"Messengers":["\u041c\u0435\u0441\u0435\u043d\u0434\u0436\u0435\u0440\u0438"],"Bot token":["\u0422\u043e\u043a\u0435\u043d \u0431\u043e\u0442\u0430"],"From @BotFather. Stored on the server only.":["\u0412\u0456\u0434 @BotFather. \u0417\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u043b\u0438\u0448\u0435 \u043d\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0456."],"Chat IDs":["ID \u0447\u0430\u0442\u0456\u0432"],"One or more, separated by commas.":["\u041e\u0434\u0438\u043d \u0430\u0431\u043e \u043a\u0456\u043b\u044c\u043a\u0430, \u0447\u0435\u0440\u0435\u0437 \u043a\u043e\u043c\u0443."],"Default tab":["\u0412\u043a\u043b\u0430\u0434\u043a\u0430 \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c"],"Guests always see all three tabs. This only chooses which one opens first.":["\u0413\u0456\u0441\u0442\u044c \u0437\u0430\u0432\u0436\u0434\u0438 \u0431\u0430\u0447\u0438\u0442\u044c \u0443\u0441\u0456 \u0442\u0440\u0438 \u0432\u043a\u043b\u0430\u0434\u043a\u0438. \u0422\u0443\u0442 \u043b\u0438\u0448\u0435 \u044f\u043a\u0430 \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0454\u0442\u044c\u0441\u044f \u043f\u0435\u0440\u0448\u043e\u044e."],"Form text":["\u0422\u0435\u043a\u0441\u0442\u0438 \u0444\u043e\u0440\u043c\u0438"],"Blank field = plugin default (site language). Text here overrides it.":["\u041f\u043e\u0440\u043e\u0436\u043d\u0454 \u043f\u043e\u043b\u0435 = \u0442\u0438\u043f\u043e\u0432\u0438\u0439 \u0442\u0435\u043a\u0441\u0442 \u043f\u043b\u0430\u0433\u0456\u043d\u0430. \u0422\u0435\u043a\u0441\u0442 \u0442\u0443\u0442 \u0437\u0430\u043c\u0456\u043d\u044e\u0454 \u0439\u043e\u0433\u043e."],"Default":["\u0417\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c"],"Style settings":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0441\u0442\u0438\u043b\u044e"],"Style":["\u0421\u0442\u0438\u043b\u044c"],"Primary color, background, text, border, radius, shadow, font.":["\u041e\u0441\u043d\u043e\u0432\u043d\u0438\u0439 \u043a\u043e\u043b\u0456\u0440, \u0444\u043e\u043d, \u0442\u0435\u043a\u0441\u0442, \u0440\u0430\u043c\u043a\u0430, \u0440\u0430\u0434\u0456\u0443\u0441, \u0442\u0456\u043d\u044c, \u0448\u0440\u0438\u0444\u0442."],"Open style settings":["\u0412\u0456\u0434\u043a\u0440\u0438\u0442\u0438 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0441\u0442\u0438\u043b\u044e"],"Preview":["\u041f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u0456\u0439 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434"],"New embeds will start as %s.":["\u041d\u043e\u0432\u0456 \u0432\u0441\u0442\u0430\u0432\u043a\u0438 \u043f\u043e\u0447\u043d\u0443\u0442\u044c \u044f\u043a \u00ab%s\u00bb."],"Save settings":["\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f"],"Overview":["\u041e\u0433\u043b\u044f\u0434"],"4WP Booking renders a native calendar. Requests go through WordPress REST. Provider API keys never reach the browser.":["4WP Booking \u043f\u043e\u043a\u0430\u0437\u0443\u0454 \u0432\u043b\u0430\u0441\u043d\u0438\u0439 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440. \u0417\u0430\u043f\u0438\u0442\u0438 \u0439\u0434\u0443\u0442\u044c \u0447\u0435\u0440\u0435\u0437 WordPress REST. API-\u043a\u043b\u044e\u0447\u0456 \u043f\u0440\u043e\u0432\u0430\u0439\u0434\u0435\u0440\u0430 \u0432 \u0431\u0440\u0430\u0443\u0437\u0435\u0440 \u043d\u0435 \u043f\u043e\u0442\u0440\u0430\u043f\u043b\u044f\u044e\u0442\u044c."],"ClinicCards is the first implemented provider. Google Calendar and Calendly appear as roadmap stubs.":["ClinicCards \u2014 \u043f\u0435\u0440\u0448\u0438\u0439 \u0440\u0435\u0430\u043b\u0456\u0437\u043e\u0432\u0430\u043d\u0438\u0439 \u043f\u0440\u043e\u0432\u0430\u0439\u0434\u0435\u0440. Google Calendar \u0456 Calendly \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0456 \u044f\u043a \u0437\u0430\u0433\u043b\u0443\u0448\u043a\u0438 \u0432 \u043f\u043b\u0430\u043d\u0430\u0445."],"Shortcode":["\u0428\u043e\u0440\u0442\u043a\u043e\u0434"],"Optional attributes: provider, template (advanced or calendar), flow (staff, date, or service). Example: [forwp_booking template=\"advanced\"]":["\u041d\u0435\u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u0456 \u0430\u0442\u0440\u0438\u0431\u0443\u0442\u0438: provider, template (advanced \u0430\u0431\u043e calendar), flow (staff, date \u0430\u0431\u043e service). \u041f\u0440\u0438\u043a\u043b\u0430\u0434: [forwp_booking template=\"advanced\"]"],"Gutenberg and Elementor":["Gutenberg \u0456 Elementor"],"Insert the 4WP Booking block, or the Elementor widget if Elementor is active. Elementor is optional.":["\u0412\u0441\u0442\u0430\u0432\u0442\u0435 \u0431\u043b\u043e\u043a 4WP Booking \u0430\u0431\u043e \u0432\u0456\u0434\u0436\u0435\u0442 Elementor, \u044f\u043a\u0449\u043e Elementor \u0430\u043a\u0442\u0438\u0432\u043d\u0438\u0439. Elementor \u043d\u0435 \u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u0438\u0439."],"Providers":["\u041f\u0440\u043e\u0432\u0430\u0439\u0434\u0435\u0440\u0438"],"Settings":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f"],"Documentation":["\u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0456\u044f"]}}}